{
  "name": "mentor",
  "displayName": "Mentor",
  "description": "Un mentor de IA dentro del editor: te guía con pistas y preguntas en vez de escribir el código por ti. Usa tu clave de API o tu suscripción (Claude Code, Cursor), y sigue los planes de Claude Code y Antigravity.",
  "version": "0.8.0",
  "publisher": "santolan31",
  "license": "SEE LICENSE IN LICENSE",
  "repository": { "type": "git", "url": "https://github.com/santolan31/kmp-interview-coach" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Education", "AI", "Programming Languages"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "mentor", "title": "Mentor", "icon": "media/mentor.svg" }
      ]
    },
    "views": {
      "mentor": [
        { "type": "webview", "id": "mentor.panel", "name": "Conversación" }
      ]
    },
    "commands": [
      { "command": "mentor.toggle", "title": "Encender o apagar el Mentor en este archivo", "category": "Mentor" },
      { "command": "mentor.openPanel", "title": "Abrir el panel", "category": "Mentor" },
      { "command": "mentor.chooseProvider", "title": "Elegir proveedor (clave de API o suscripción)", "category": "Mentor" },
      { "command": "mentor.chooseModel", "title": "Elegir modelo", "category": "Mentor" },
      { "command": "mentor.chooseSession", "title": "Elegir la conversación o el plan que lee el Mentor", "category": "Mentor" },
      { "command": "mentor.setApiKey", "title": "Poner o cambiar la clave de API", "category": "Mentor" },
      { "command": "mentor.testConnection", "title": "Probar la conexión con la IA", "category": "Mentor" },
      { "command": "mentor.loginCli", "title": "Iniciar sesión en mi suscripción (terminal)", "category": "Mentor" },
      { "command": "mentor.pastePlan", "title": "Pegar el plan (del portapapeles)", "category": "Mentor" },
      { "command": "mentor.clearPastedPlan", "title": "Quitar el plan pegado", "category": "Mentor" },
      { "command": "mentor.review", "title": "Revisar este archivo", "category": "Mentor" },
      { "command": "mentor.hint", "title": "Dame una pista", "category": "Mentor" },
      { "command": "mentor.giveUp", "title": "Me rindo: explícame la solución", "category": "Mentor" },
      { "command": "mentor.hideHint", "title": "Ocultar la pista del editor", "category": "Mentor" },
      { "command": "mentor.reply", "title": "Responder", "category": "Mentor", "enablement": "!commentIsEmpty" },
      { "command": "mentor.resolveComment", "title": "Resolver (quitar del editor)", "category": "Mentor", "icon": "$(check)" },
      { "command": "mentor.guide.goTo", "title": "Ir a lo que falta del paso", "category": "Mentor" },
      { "command": "mentor.guide.goToLine", "title": "Ir a la línea", "category": "Mentor" },
      { "command": "mentor.guide.skeleton", "title": "Poner el esqueleto del paso", "category": "Mentor" },
      { "command": "mentor.guide.verify", "title": "¿Cumple el paso?", "category": "Mentor" },
      { "command": "mentor.guide.explain", "title": "Explícame este paso", "category": "Mentor" },
      { "command": "mentor.guide.advance", "title": "Avanzar al siguiente paso", "category": "Mentor" },
      { "command": "mentor.guide.done", "title": "Marcar el paso como hecho", "category": "Mentor" }
    ],
    "menus": {
      "comments/commentThread/context": [
        { "command": "mentor.reply", "group": "inline", "when": "commentController == mentor" }
      ],
      "comments/commentThread/title": [
        { "command": "mentor.resolveComment", "group": "inline", "when": "commentController == mentor" }
      ],
      "commandPalette": [
        { "command": "mentor.reply", "when": "false" },
        { "command": "mentor.resolveComment", "when": "false" },
        { "command": "mentor.guide.goTo", "when": "false" },
        { "command": "mentor.guide.goToLine", "when": "false" },
        { "command": "mentor.guide.skeleton", "when": "false" },
        { "command": "mentor.guide.verify", "when": "false" },
        { "command": "mentor.guide.explain", "when": "false" },
        { "command": "mentor.guide.advance", "when": "false" },
        { "command": "mentor.guide.done", "when": "false" }
      ]
    },
    "keybindings": [
      { "command": "mentor.toggle", "key": "ctrl+alt+shift+t", "mac": "cmd+alt+shift+t", "when": "editorTextFocus" },
      { "command": "mentor.hint", "key": "ctrl+alt+shift+h", "mac": "cmd+alt+shift+h", "when": "editorTextFocus" },
      { "command": "mentor.hideHint", "key": "escape", "when": "editorTextFocus && mentor.hintVisible && !suggestWidgetVisible && !inlineSuggestionVisible" }
    ],
    "configuration": {
      "title": "Mentor",
      "properties": {
        "mentor.provider": {
          "type": "string",
          "default": "anthropic",
          "enum": ["anthropic", "openai", "gemini", "groq", "openrouter", "ollama", "custom", "claude-cli", "cursor-cli", "copilot-vscode"],
          "enumDescriptions": [
            "Anthropic (Claude) con tu clave de API",
            "OpenAI con tu clave de API",
            "Google Gemini con tu clave de Google AI Studio (la forma permitida de usar Gemini desde otras herramientas)",
            "Groq con tu clave de API",
            "OpenRouter con tu clave de API",
            "Ollama en tu computador, sin clave",
            "Otro servicio compatible con OpenAI",
            "Tu suscripción Claude Pro/Max a través de Claude Code (claude)",
            "Tu suscripción de Cursor a través de cursor-agent (experimental)",
            "Tu suscripción de GitHub Copilot, con la sesión que ya tienes en VS Code (solo VS Code; te pide permiso la primera vez)"
          ],
          "markdownDescription": "Con quién piensa el Mentor. Las opciones de **suscripción** usan tu propia sesión (el programa oficial de cada servicio, o GitHub Copilot dentro de VS Code): sin clave ni costo por llamada, gastan la cuota de tu plan. La clave de API se guarda con `Mentor: Elegir proveedor`, en el almacén seguro de VS Code."
        },
        "mentor.model": { "type": "string", "default": "", "description": "Modelo. Vacío = el que recomienda el proveedor (o el que use el programa de tu suscripción)." },
        "mentor.baseUrl": { "type": "string", "default": "", "description": "URL del servicio (solo «Otro compatible con OpenAI»), o la ruta del programa de tu suscripción si no está en el PATH. Vacío = lo normal." },
        "mentor.level": { "type": "string", "default": "junior", "enum": ["junior", "semi", "senior"], "enumDescriptions": ["Junior", "Semi Senior", "Senior"], "description": "Tu nivel: el Mentor ajusta cuánto te explica." },
        "mentor.language": { "type": "string", "default": "es", "enum": ["es", "en"], "enumDescriptions": ["Español", "English"], "description": "Idioma de las respuestas." },
        "mentor.maxComments": { "type": "number", "default": 5, "minimum": 1, "maximum": 10, "description": "Comentarios por revisión, como máximo." },
        "mentor.readAiSession": { "type": "boolean", "default": true, "markdownDescription": "Con el Mentor encendido en un archivo, leer tu conversación con Claude Code o Antigravity para saber en qué paso vas. Solo se envía al proveedor que elegiste." }
      }
    }
  },
  "scripts": {
    "core": "cd .. && ./gradlew :core:jsNodeProductionLibraryDistribution -q",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "npm run build && esbuild test/*.test.ts --bundle --platform=node --format=cjs --outdir=out/test --external:vscode --log-level=warning && node --test \"out/test/*.test.js\"",
    "package": "npm run core && npm run check && npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
